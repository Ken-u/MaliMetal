+#ifdef __APPLE__
+VKAPI_ATTR VkResult VKAPI_CALL
+panvk_GetMemoryHostPointerPropertiesEXT(
+   VkDevice _device, VkExternalMemoryHandleTypeFlagBits handleType,
+   const void *pHostPointer,
+   VkMemoryHostPointerPropertiesEXT *pMemoryHostPointerProperties)
+{
+   VK_FROM_HANDLE(panvk_device, device, _device);
+   const struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(device->vk.physical);
+
+   if (handleType != VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT ||
+       ((uintptr_t)pHostPointer & 4095))
+      return panvk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   /* The imported pages keep the owner's CPU mapping; the importer cleans and
+    * invalidates its own caches around the GPU's use (as an IOSurface's owner
+    * does), so they are offered as the host-visible coherent types. */
+   pMemoryHostPointerProperties->memoryTypeBits = 0;
+   for (uint32_t i = 0; i < phys_dev->memory.type_count; i++) {
+      const VkMemoryPropertyFlags want = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                         VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+      if ((phys_dev->memory.types[i].propertyFlags & want) == want)
+         pMemoryHostPointerProperties->memoryTypeBits |= 1u << i;
+   }
+   return VK_SUCCESS;
+}
+#endif
