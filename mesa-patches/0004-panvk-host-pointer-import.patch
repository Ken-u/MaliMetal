+#ifdef __APPLE__
+struct pan_kmod_bo *
+pan_kmod_bo_import_host(struct pan_kmod_dev *dev, void *ptr, size_t size)
+{
+   struct pan_kmod_bo *bo = NULL;
+   struct pan_kmod_bo **slot;
+
+   simple_mtx_lock(&dev->handle_to_bo.lock);
+
+   uint32_t handle;
+   if (drm_darwin_bo_create_host(dev->fd, ptr, size, &handle))
+      goto err_unlock;
+
+   slot = util_sparse_array_get(&dev->handle_to_bo.array, handle);
+   if (!slot || *slot)
+      goto err_close_handle;
+
+   bo = dev->ops->bo_import(dev, handle, size);
+   if (!bo)
+      goto err_close_handle;
+
+   *slot = bo;
+   simple_mtx_unlock(&dev->handle_to_bo.lock);
+   return bo;
+
+err_close_handle:
+   drmCloseBufferHandle(dev->fd, handle);
+
+err_unlock:
+   simple_mtx_unlock(&dev->handle_to_bo.lock);
+   return NULL;
+}
+#endif
