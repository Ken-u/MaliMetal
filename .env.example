# Copy to .env and fill in. .env is git-ignored.

# clang/lld toolchain bin directory (clang-20, ld64.lld, llvm-ar...), e.g. AOSP prebuilts clang-r547379
LLVM_BIN=
# clang with llvm-as for LLVM 21+ (the bridge fixtures), e.g. AOSP prebuilts clang-r596125
LLVM_BIN_NEW=
# iPhoneOS 16.5 SDK directory (iPhoneOS16.5.sdk)
IOS_SDK=
# Work directory of the Mesa/PanVK build (source, prefix, build trees); see mesa-build/README.md
MESA_BUILD=
# Rust bridge: pinned metal2vulkan checkout and the output directory of build-bridge.sh
M2V=
BRIDGE_OUT=
# UniXNU main checkout (for drivers/AdrenoMetal upstream patches and the DarwinBoot tooling)
UNIXNU=
# UniXNU-evb10 checkout (usertest/build.sh updates its board.toml) and uefi-evb10 checkout (owner trust bundle tool)
DEVICE_DIR=
UEFI_EVB10_DIR=
# Mali kernel driver checkout (default: ../Mali)
#MALI_DIR=
# Mesa source copy to patch (a plain copy of the Mesa tree, 26.1-devel)
MESA_SRC_ORIG=
